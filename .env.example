# ── Azure DevOps ────────────────────────────────────────────────────────────
# Organisation root URL (no trailing slash)
ADO_ORG_URL=https://dev.azure.com/your-org

# Project name (must match exactly as shown in ADO)
ADO_PROJECT=YourProject

# Team name inside the project (defaults to "<project> Team" when omitted)
ADO_TEAM=YourTeam

# Personal Access Token — needs: Work Items (Read & Write), Project & Team (Read)
ADO_PAT=your-personal-access-token-here

# ── MCP Server ───────────────────────────────────────────────────────────────
# Static API key sent by Copilot Studio as the X-Api-Key header.
# Leave blank to disable key enforcement (useful for local dev).
API_KEY=change-me-before-deploying

# Display name shown in Copilot Studio's tool picker
MCP_SERVER_NAME=Sprint Health

# Port — Azure App Service injects PORT automatically; local default is 8000
PORT=8000

# ── Risk / Load Thresholds ───────────────────────────────────────────────────
# Days an item may stay in an active state before it is flagged as stale
AT_RISK_STALE_DAYS=3

# Ratio of team-average committed points above which a member is "over_allocated"
OVERLOAD_THRESHOLD_MULTIPLIER=1.5

# Ratio below which a member is "under_allocated"
UNDERLOAD_THRESHOLD_MULTIPLIER=0.5
